-main ApplicationMain 
--macro openfl.utils._internal.ExtraParamsMacro.include()
-cp D:/haxe/haxe/lib/openfl/9,5,2/src
-D openfl=9.5.2
--macro lime._internal.macros.DefineMacro.run()
--macro haxe.macro.Compiler.addMetadata("@:autoBuild(lime._internal.macros.AssetsMacro.embedBytes())", "haxe.io.Bytes")
-cp D:/haxe/haxe/lib/lime/8,3,2/src
-D lime=8.3.2
-cp D:/haxe/haxe/lib/actuate/1,9,0/src
-D actuate=1.9.0
-cp Source
-cp D:/haxe/haxe/lib/lime/8,3,2/externs/air
-cp D:/haxe/haxe/lib/openfl/9,5,2/lib/flash-externs/src
-D native-trace
-D tools=8.3.2
-D flash-use-stage
-D lime-opengl
-D no-compilation
-D openfl-flash
-D air
-D desktop
--macro allowPackage('sys')
--connect
6000
-cp Export/air
-swf-lib obj/assets.swf
-swf-version 17
-swf Export/air/bin/PiratePig.swf
-cp Export/air/haxe
-D final
-D air